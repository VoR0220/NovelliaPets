{
  "name": "novellia-pets",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=@novellia/server",
    "docker:up": "docker compose up -d --pull never",
    "docker:down": "docker compose down"
  }
}
